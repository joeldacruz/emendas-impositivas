# Copie para .env e ajuste. NUNCA versione o .env.
# Os valores abaixo são padrões descartáveis para o PostgreSQL local do docker-compose.yml.
# Em qualquer outro ambiente, use credenciais próprias fornecidas fora do repositório.

# desenvolvimento | teste | producao
AMBIENTE=desenvolvimento
HOST=127.0.0.1
PORT=3100
# debug | info | warn | error | fatal | silent
LOG_LEVEL=info

DATABASE_URL=postgres://emendas:emendas_dev@localhost:5433/emendas_dev

# Usado apenas pelos testes de persistência (banco separado, criado pelo docker-compose).
TEST_DATABASE_URL=postgres://emendas:emendas_dev@localhost:5433/emendas_test
