{
  "name": "emendas-impositivas",
  "version": "0.1.0",
  "description": "Gestão de emendas impositivas municipais",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "seed": "tsx src/scripts/seed-dev.ts",
    "importar": "tsx src/scripts/importar-financeiro.ts",
    "financeiro": "tsx src/scripts/financeiro.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeldacruz/emendas-impositivas.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/joeldacruz/emendas-impositivas/issues"
  },
  "homepage": "https://github.com/joeldacruz/emendas-impositivas#readme",
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
